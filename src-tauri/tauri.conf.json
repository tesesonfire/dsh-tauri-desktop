{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsh-tauri-desktop",
  "version": "0.1.0",
  "identifier": "com.dshtauri.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splash",
        "title": "dsh-tauri-desktop",
        "url": "splashscreen.html",
        "width": 420,
        "height": 280,
        "resizable": false,
        "decorations": false,
        "center": true,
        "skipTaskbar": true,
        "focus": false
      },
      {
        "label": "main",
        "title": "dsh-tauri-desktop",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 dsh-tauri-desktop contributors",
    "shortDescription": "DeepSeek Harness 桌面壳",
    "longDescription": "dsh（DeepSeek Harness）的 Tauri 2 原生桌面壳：窗口管理、内嵌 WebUI、插件系统、进程生命周期、自更新、跨平台分发。",
    "targets": ["nsis", "dmg", "app", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/presets.json"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
